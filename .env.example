# Supabase project credentials (Project Settings → API).
# These are EXPO_PUBLIC_* so they are embedded in the client bundle — use the anon key, never the service_role key.
EXPO_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# White-label: this build serves a single shop. Set to the shops.id this app is for.
EXPO_PUBLIC_SHOP_ID=00000000-0000-0000-0000-000000000000

# Optional — deposits. Without this key the app still shows and records deposits,
# it just never opens the payment sheet. Needs a dev/EAS build (native module).
# EXPO_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...
